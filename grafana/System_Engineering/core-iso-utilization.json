          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  Region,\n  Hostname,\n  \"Instance_Type\"                       AS instance_type,\n  \"Cores_Not_In_Used_Socket_0\"          AS cores_not_used_s0,\n  \"Cores_Not_In_Used_Socket_1\"          AS cores_not_used_s1\nFROM (\n  SELECT\n    Region,\n    Hostname,\n    \"Instance_Type\",\n    \"Cores_Not_In_Used_Socket_0\",\n    \"Cores_Not_In_Used_Socket_1\",\n    ts,\n    ROW_NUMBER() OVER (PARTITION BY Hostname ORDER BY ts DESC) AS rn\n  FROM isolated_cores_zero_util\n  WHERE Hostname IN (${Hostname:sqlstring})\n) s\nWHERE rn = 1\nORDER BY Hostname;",
