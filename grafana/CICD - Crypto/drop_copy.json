          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n    dca.account_id,\n    dca.bucket,\n    dca.exchange_name,\n    dca.status,\n    dca.net_value,\n    dca.maintenance_margin,\n    dca.exchange_margin_ratio,\n    dca.timestamp\nFROM \n    sln_dropcopy.dropcopy_accounts_v2 dca\nINNER JOIN (\n    SELECT \n        account_id, \n        bucket, \n        MAX(timestamp) AS max_timestamp\n    FROM \n        sln_dropcopy.dropcopy_accounts_v2\n    WHERE \n        exchange_name = 'BINANCE' AND\n        exchange_margin_ratio IS NOT NULL\n        AND $__timeFilter(datetime)\n    GROUP BY \n        account_id, bucket\n) AS recent\nON \n    dca.account_id = recent.account_id AND \n    dca.bucket = recent.bucket AND \n    dca.timestamp = recent.max_timestamp\nWHERE \n    dca.exchange_name = 'BINANCE' AND \n    dca.exchange_margin_ratio IS NOT NULL\n    AND $__timeFilter(datetime)\nORDER BY \n    dca.exchange_margin_ratio ASC\nLIMIT 5;\n",
          "refId": "A",
